{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "green-control-theme",
  "type": "registry:theme",
  "title": "Green Control theme",
  "description": "Green Control tokens as CSS variables. light = Day, dark = Night. Square corners, one accent.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Hanken Grotesk\", system-ui, sans-serif",
      "font-mono": "\"DM Mono\", ui-monospace, monospace",
      "radius": "0px",
      "gc-ease": "cubic-bezier(0.2, 0, 0, 1)",
      "gc-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "gc-confidence-act": "80",
      "gc-confidence-review": "50"
    },
    "light": {
      "gc-bg-page": "#f1f1ef",
      "gc-bg-surface": "#fbfbfa",
      "gc-bg-raised": "#ececea",
      "gc-bg-chip": "#e4e4e1",
      "gc-line": "#dcdcd8",
      "gc-text": "#111111",
      "gc-muted": "#666662",
      "gc-accent": "#1f4fff",
      "gc-on-accent": "#ffffff",
      "gc-glass": "rgba(251, 251, 250, 0.82)",
      "gc-glass-raised": "rgba(236, 236, 233, 0.92)",
      "background": "#f1f1ef",
      "foreground": "#111111",
      "card": "#fbfbfa",
      "card-foreground": "#111111",
      "popover": "#fbfbfa",
      "popover-foreground": "#111111",
      "primary": "#1f4fff",
      "primary-foreground": "#ffffff",
      "secondary": "#ececea",
      "secondary-foreground": "#111111",
      "muted": "#ececea",
      "muted-foreground": "#666662",
      "accent": "#ececea",
      "accent-foreground": "#111111",
      "border": "#dcdcd8",
      "input": "#dcdcd8",
      "ring": "#111111",
      "gc-sheen": "rgba(255, 255, 255, 0.25)",
      "gc-edge-hi": "rgba(255, 255, 255, 0.5)",
      "gc-drop": "0 16px 40px rgba(17, 20, 30, 0.08)",
      "gc-link": "#1f4fff",
      "gc-cta-bg": "#1f4fff",
      "gc-cta-fg": "#ffffff",
      "gc-sel-bg": "#1f4fff",
      "gc-sel-fg": "#ffffff",
      "gc-badge-bg": "#1f4fff"
    },
    "dark": {
      "gc-bg-page": "#111214",
      "gc-bg-surface": "#1b1c1f",
      "gc-bg-raised": "#2b2d30",
      "gc-bg-chip": "#292a2e",
      "gc-line": "#33363b",
      "gc-text": "#ededed",
      "gc-muted": "#8f949c",
      "gc-accent": "#ff6b1a",
      "gc-on-accent": "#111214",
      "gc-glass": "rgba(27, 28, 31, 0.78)",
      "gc-glass-raised": "rgba(43, 45, 48, 0.85)",
      "background": "#111214",
      "foreground": "#ededed",
      "card": "#1b1c1f",
      "card-foreground": "#ededed",
      "popover": "#1b1c1f",
      "popover-foreground": "#ededed",
      "primary": "#ededed",
      "primary-foreground": "#111214",
      "secondary": "#2b2d30",
      "secondary-foreground": "#ededed",
      "muted": "#2b2d30",
      "muted-foreground": "#8f949c",
      "accent": "#2b2d30",
      "accent-foreground": "#ededed",
      "border": "#33363b",
      "input": "#33363b",
      "ring": "#ededed",
      "gc-sheen": "rgba(255, 255, 255, 0.02)",
      "gc-edge-hi": "rgba(255, 255, 255, 0.035)",
      "gc-drop": "0 16px 40px rgba(0, 0, 0, 0.35)",
      "gc-link": "#ededed",
      "gc-cta-bg": "#ededed",
      "gc-cta-fg": "#111214",
      "gc-sel-bg": "#2b2d30",
      "gc-sel-fg": "#ededed",
      "gc-badge-bg": "#ededed"
